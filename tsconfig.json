{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@hachimi/core": ["./packages/core/src/index.ts"],
      "@hachimi/core/*": ["./packages/core/src/*"],
      "@hachimi/shared": ["./packages/shared/src/index.ts"],
      "@hachimi/shared/*": ["./packages/shared/src/*"],
      "@hachimi/config": ["./packages/config/src/index.ts"],
      "@hachimi/config/*": ["./packages/config/src/*"],
      "@hachimi/storage": ["./packages/storage/src/index.ts"],
      "@hachimi/storage/*": ["./packages/storage/src/*"],
      "@hachimi/evals": ["./packages/evals/src/index.ts"],
      "@hachimi/evals/*": ["./packages/evals/src/*"],
      "@hachimi/channel-api": ["./packages/channels/api/src/index.ts"],
      "@hachimi/channel-api/*": ["./packages/channels/api/src/*"],
      "@hachimi/channel-cli": ["./packages/channels/cli/src/index.ts"],
      "@hachimi/channel-cli/*": ["./packages/channels/cli/src/*"],
      "@hachimi/channel-telegram": ["./packages/channels/telegram/src/index.ts"],
      "@hachimi/channel-telegram/*": ["./packages/channels/telegram/src/*"],
      "@hachimi/channel-web": ["./packages/channels/web/src/index.ts"],
      "@hachimi/channel-web/*": ["./packages/channels/web/src/*"],
      "@hachimi/channel-acp": ["./packages/channels/acp/src/index.ts"],
      "@hachimi/channel-acp/*": ["./packages/channels/acp/src/*"],
      "@hachimi/ui": ["./packages/ui/src/index.ts"],
      "@hachimi/ui/*": ["./packages/ui/src/*"]
    }
  },
  "include": ["packages/**/*", "apps/**/*"],
  "exclude": ["node_modules", "dist", "**/dist", "apps/web", "apps/desktop", "packages/ui", "demo"]
}
